# Copy this file to .env.local and fill in your actual Discord Client ID
# .env.local is ignored by git for security

# Discord OAuth Configuration
VITE_DISCORD_CLIENT_ID=

# To get your Discord Client ID:
# 1. Go to https://discord.com/developers/applications
# 2. Create a new application or select existing one
# 3. Copy the "Application ID" from General Information
# 4. In OAuth2 settings, add redirect URI: http://localhost:3000/admin/callback (for dev)
# 5. Paste the Application ID as the value above